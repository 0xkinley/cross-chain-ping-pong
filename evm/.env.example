# Environment variables for EVM deployment and testing
PRIVATE_KEY=your_private_key_here
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHERSCAN_API_KEY=your_etherscan_api_key
REPORT_GAS=true

# LayerZero Endpoint addresses
LZ_ENDPOINT_SEPOLIA=0x6EDCE65403992e310A62460808c4b910D972f10f
LZ_ENDPOINT_SOLANA_TESTNET=0x0  # Will be updated when Solana testnet is configured

# Peer Chain IDs (LayerZero endpoint IDs)
SEPOLIA_CHAIN_ID=40161
SOLANA_TESTNET_CHAIN_ID=40168